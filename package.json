{
  "name": "hotel_system",
  "version": "1.0.0",
  "description": "Веб-приложение для управления гостиницей.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "test": "echo \"No tests in root yet\" && exit 0",
    "lint:backend": "cd hotel_backend && gradlew.bat checkstyleMain checkstyleTest spotbugsMain",
    "lint:frontend": "cd hotel-frontend && npm run lint && npm run format:check",
    "lint": "npm run lint:backend && npm run lint:frontend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adeoneee/hotel_system.git"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.6",
    "lint-staged": "^16.4.0"
  },
  "lint-staged": {
    "hotel-frontend/**/*.{ts,tsx}": [
      "npm --prefix hotel-frontend exec -- eslint --fix",
      "npm --prefix hotel-frontend exec -- prettier --write"
    ],
    "hotel-frontend/**/*.{css,json,md}": [
      "npm --prefix hotel-frontend exec -- prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/adeoneee/hotel_system/issues"
  },
  "homepage": "https://github.com/adeoneee/hotel_system#readme"
}
